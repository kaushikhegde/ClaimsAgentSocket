GEMINI_API_KEY=your-gemini-api-key-here          # still used for post-call evaluation
GEMINI_TEXT_MODEL=gemini-2.5-flash
DATABASE_URL=postgresql://postgres:password@localhost:5432/claims_agent
PORT=3000
NODE_ENV=development

# ElevenLabs Agents (voice + LLM runtime for training calls). Create the key at
# https://elevenlabs.io/app/developers/api-keys with ElevenAgents=Write, Voices=Write, User=Access.
ELEVENLABS_API_KEY=sk_your-elevenlabs-key
# ELEVENLABS_LLM=gemini-2.5-flash
# ELEVENLABS_TTS_MODEL=eleven_flash_v2
# ELEVENLABS_RAG_MODEL=e5_mistral_7b_instruct
# ELEVENLABS_DEFAULT_VOICE_ID=            # optional fallback voice for seeded scenarios

# Postgres SSL: auto-enabled for *.azure.com hosts. Override with:
#   DATABASE_SSL=true    -> encrypt, skip cert verification (default for Azure)
#   DATABASE_SSL=verify  -> encrypt + verify server identity
#   DATABASE_SSL=false   -> disable SSL (local dev)
# DATABASE_SSL=true

# Azure Blob Storage for call recordings (service-principal auth).
# Stored under the "claims-agent/" prefix in the container. Leave unset to use local disk.
TENANT_ID=your-azure-tenant-id
CLIENT_ID=your-service-principal-client-id
CLIENT_SECRET=your-service-principal-client-secret
STORAGE_NAME=your-storage-account-name
CONTAINER_NAME=your-blob-container-name
